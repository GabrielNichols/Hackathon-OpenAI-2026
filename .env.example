# The default is local and makes no paid API calls.
PROCUREMENT_INTERPRETER=local
OPENAI_PROCUREMENT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1200

# Prefer setting OPENAI_API_KEY in the server environment. For local development,
# the backend also reads .secrets/openai_api_key.txt (the directory is gitignored).
