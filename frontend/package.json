{
  "name": "canal-agente-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "build": "tsc -b --pretty false && vite build"
